        "apiKey": "dummy",
        "models": [
          {
            "id": "qwen3.5-122b",
            "name": "qwen3.5-122b",
            "contextWindow": 131072,
            "maxTokens": 8192
          },
          {
            "id": "gemma-4-26b",
            "name": "gemma-4-26b",

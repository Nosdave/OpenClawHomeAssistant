{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "fake-gateway-token-for-unit-tests"
    },
    "controlUi": {
      "dangerouslyDisableDeviceAuth": true
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "vllm/qwen3.5-122b",
        "fallbacks": [
          "openai/gpt-5.5",
          "anthropic/claude-opus-4-8",
          "google/gemini-3.1-pro-preview"
        ]
      },
      "models": {
        "anthropic/claude-opus-4-6": {},
        "anthropic/claude-sonnet-4-6": {},
        "anthropic/claude-opus-4-5": {},
        "anthropic/claude-sonnet-4-5": {},
        "anthropic/claude-haiku-4-5": {},
        "openai/gpt-5.4": {},
        "openai/gpt-5.4-pro": {},
        "openai/gpt-5.1-codex": {
          "alias": "GPT"
        },
        "google/gemini-3.1-pro-preview": {},
        "google/gemini-flash-latest": {},
        "anthropic/claude-opus-4-7": {},
        "ollama/*": {},
        "anthropic/claude-opus-4-8": {},
        "openai/gpt-5.5": {},
        "openai/gpt-5.5-pro": {},
        "vllm/qwen3.5-122b": {},
        "vllm-nothink/qwen3.5-122b": {},
        "vllm/gemma-4-26b": {},
        "vllm-fast/qwen3.6-35b": {},
        "anthropic/*": {},
        "openai/*": {},
        "xai/grok-4.7": {},
        "xai/grok-4.7-build-fast": {},
        "xai/grok-4.3": {
          "alias": "Grok"
        },
        "xai/grok-4.6": {}
      },
      "workspace": "/config/clawd",
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "1h"
      },
      "compaction": {
        "mode": "safeguard"
      },
      "heartbeat": {
        "every": "1h"
      },
      "thinkingDefault": "low",
      "imageGenerationModel": {
        "primary": "openai/gpt-image-1"
      },
      "subagents": {
        "archiveAfterMinutes": 60,
        "runTimeoutSeconds": 120
      },
      "pdfModel": {
        "primary": "vllm/qwen3.5-122b"
      }
    },
    "list": [
      {
        "id": "main",
        "tools": {
          "profile": "full",
          "alsoAllow": [
            "tts"
          ]
        }
      },
      {
        "id": "mail_reader",
        "workspace": "/config/clawd-mail-reader",
        "model": "vllm/qwen3.5-122b",
        "sandbox": {
          "mode": "all",
          "scope": "session",
          "workspaceAccess": "none"
        },
        "tools": {
          "profile": "minimal",
          "allow": [
            "session_status"
          ],
          "deny": [
            "group:fs",
            "group:runtime",
            "group:web",
            "browser",
            "cron",
            "gateway",
            "nodes"
          ]
        }
      }
    ]
  },
  "plugins": {
    "entries": {
      "google": {
        "enabled": true,
        "config": {
          "webSearch": {
            "apiKey": "DUMMY-google"
          }
        }
      },
      "brave": {
        "enabled": true,
        "config": {
          "webSearch": {
            "apiKey": "DUMMY-brave"
          }
        }
      },
      "elevenlabs": {
        "enabled": true,
        "config": {}
      },
      "microsoft": {
        "enabled": true,
        "config": {}
      },
      "anthropic": {
        "enabled": true
      },
      "openai": {
        "enabled": true
      },
      "memory-core": {
        "config": {
          "dreaming": {
            "enabled": true
          }
        }
      },
      "browser": {
        "enabled": false
      },
      "acpx": {
        "enabled": true,
        "config": {
          "permissionMode": "approve-all",
          "nonInteractivePermissions": "deny"
        }
      },
      "ollama": {
        "enabled": true
      },
      "xai": {
        "enabled": true,
        "config": {
          "webSearch": {
            "inlineCitations": false
          },
          "codeExecution": {
            "enabled": false
          },
          "xSearch": {
            "enabled": false,
            "inlineCitations": false
          }
        }
      }
    }
  },
  "meta": {
    "lastTouchedVersion": "2026.7.35",
    "lastTouchedAt": "2026-10-09T15:52:32.905Z"
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "123456:FAKE-TOKEN-FOR-UNIT-TESTS",
      "dmPolicy": "pairing"
    }
  },
  "models": {
    "providers": {
      "vllm": {
        "baseUrl": "http://127.0.0.1:9/v1",
